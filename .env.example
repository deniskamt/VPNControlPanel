# --- Приложение ------------------------------------------------------------
# Ключ подписи сессий и админских токенов. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Внешний адрес панели (по нему боты ходят в API).
PANEL_URL=https://panel.example.com

DEBUG=false

# --- База данных -----------------------------------------------------------
# Можно указывать как postgresql://, так и postgresql+asyncpg:// —
# драйвер подставится сам. Railway отдаёт готовую строку в DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/vpnpanel

# --- Первый администратор --------------------------------------------------
# Создаётся только если в базе нет ни одного админа.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Подписки --------------------------------------------------------------
# Домен, который отдаётся пользователям. ДОЛЖЕН совпадать с доменом старой
# панели Marzban, иначе выданные ранее ссылки перестанут открываться.
SUBSCRIPTION_BASE_URL=https://nexlovpn.online
# Префикс пути. В текущей установке Marzban это "c" (nexlovpn.online/c/<token>).
SUBSCRIPTION_PATH=c
# ОБЯЗАТЕЛЬНО: секрет из таблицы `jwt` старой базы Marzban.
# Его печатает scripts/migrate_from_marzban.py. Без него старые ссылки
# не пройдут проверку подписи.
SUBSCRIPTION_SECRET=
SUBSCRIPTION_TITLE=NexloVPN
SUBSCRIPTION_UPDATE_INTERVAL=12

# --- Уведомления -----------------------------------------------------------
# Бот, от имени которого приходят алерты (можно завести отдельный).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=123456789,987654321
NOTIFY_NODE_STATUS=true

# --- Фоновые задачи --------------------------------------------------------
NODE_POLL_INTERVAL=30
ENFORCE_INTERVAL=60
NODE_TIMEOUT=10

# --- Токены API ------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Лимит устройств -------------------------------------------------------
# За какое окно считать уникальные адреса подключений, минуты.
DEVICE_WINDOW_MINUTES=5
# Что делать при превышении лимита: warn — запись в журнал и уведомление,
# disable — ещё и отключить пользователя (включать обратно вручную).
DEVICE_LIMIT_ACTION=warn
